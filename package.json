{
  "name": "office-js-snippets",
  "version": "1.0.0",
  "description": "A collection of samples using the Office JavaScript API",
  "main": "config/compile.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "npm run tsc && npm run build && npm run lint",
    "tsc": "tsc -p tsconfig.build.json",
    "build": "node config/build.js",
    "lint": "eslint config/",
    "test": "jest",
    "test:compile": "jest snippet-compiler",
    "test:libs": "jest library-validator",
    "test:runtime": "jest runtime-execution --testPathIgnorePatterns=auto-generated",
    "test:runtime:all": "jest runtime-execution runtime-auto-generated",
    "test:runtime:auto": "jest runtime-auto-generated",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:report": "ts-node --project tsconfig.test.json tests/generate-failure-report.ts",
    "validate": "npm run tsc && npm run build && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OfficeDev/office-js-snippets.git"
  },
  "author": "Microsoft",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OfficeDev/office-js-snippets/issues"
  },
  "homepage": "https://github.com/OfficeDev/office-js-snippets#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "escape-string-regexp": "^4.0.0",
    "fs-extra": "11.3.4",
    "js-yaml": "^4.3.2",
    "rimraf": "^6.1.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/custom-functions-runtime": "^1.6.11",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "@types/office-js": "^1.0.593",
    "@types/office-js-preview": "^1.0.732",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "jest": "^30.3.0",
    "office-addin-manifest": "^2.1.2",
    "office-addin-mock": "^3.0.6",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "$js-yaml"
    },
    "adm-zip": "0.6.1",
    "strip-bom": "4.0.0",
    "uuid": "^11.1.1"
  }
}
